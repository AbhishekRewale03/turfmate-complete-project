{
  "name": "turfmate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/domain.test.ts tests/unit tests/integration tests/payments tests/refunds",
    "test:refunds": "vitest run tests/refunds",
    "lint": "eslint .",
    "test:unit": "vitest run tests/domain.test.ts tests/unit",
    "test:rules": "firebase emulators:exec --project turfmate-rules-test --only firestore \"vitest run tests/firestore-rules\"",
    "test:storage-rules": "firebase emulators:exec --project turfmate-storage-rules-test --only storage \"vitest run tests/storage-rules\"",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test:payments": "vitest run tests/payments",
    "test:backend": "pnpm test && pnpm test:rules && pnpm test:storage-rules",
    "pretest:e2e": "node scripts/clean-e2e-cache.mjs",
    "test:e2e": "playwright test",
    "firebase:emulators": "firebase emulators:start",
    "firebase:seed": "node --experimental-strip-types scripts/seed-firebase.ts",
    "firebase:create-owner": "node --experimental-strip-types scripts/create-owner.ts",
    "start": "next start"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.18.0",
    "firebase-admin": "13.10.0",
    "geist": "^1.7.2",
    "jose": "^6.2.10",
    "lucide-react": "^1.16.0",
    "next": "16.3.3",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "firebase-tools": "^15.29.0",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "npm@11.7.0"
}
