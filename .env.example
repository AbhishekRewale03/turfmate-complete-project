# Public Firebase web configuration
NEXT_PUBLIC_FIREBASE_API_KEY=replace_me
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=replace_me.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=replace_me
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=replace_me.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace_me
NEXT_PUBLIC_FIREBASE_APP_ID=replace_me
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=replace_me

# Server-only Firebase Admin configuration. Prefer ADC on Google-hosted runtimes.
FIREBASE_PROJECT_ID=replace_me
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
# Keep this quoted; escaped newlines are converted to real newlines at runtime.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_me\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=replace_me.firebasestorage.app

SESSION_COOKIE_NAME=turfmate_session
SESSION_COOKIE_MAX_AGE=432000
APP_URL=http://localhost:3000
APP_ENV=development
NEXT_PUBLIC_DATA_MODE=local

CASHFREE_CLIENT_ID=replace_me
CASHFREE_CLIENT_SECRET=replace_me
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2026-01-01
NEXT_PUBLIC_CASHFREE_MODE=sandbox
PAYMENT_SETTLEMENT_MODE=PLATFORM
PAYMENT_PROVIDER=mock

BOOKING_LOOKUP_HMAC_SECRET=replace_with_at_least_32_random_characters
CRON_SECRET=replace_with_at_least_32_random_characters
APP_CHECK_MODE=disabled
